{# _product_card.twig — one shop grid card (context: `product`, a ProductCardViewModel — the
   EXACT closed allowlist the wishlist endpoint and shop.js's buildProductCard() share, so
   server-rendered and client-hydrated cards can never drift). Shared by shop/index.twig and
   shop/category.twig: tile (media panel, first-category chip, hover actions) then body
   (name — THE link to the detail page — rating when reviews exist, price row). The star SVG
   convention stays commerce-owned inline and currentColor, matching the mini-cart icon.

   Cart honesty (storefront-v1 spec §3): cartMode 'direct' (exactly one active variant, no
   required add-on — AddToCartViewModel's decision, never re-derived here) renders a REAL PRG
   form posting to the SAME /_shop/cart/add endpoint shop.js's shop-form module already
   intercepts — a working no-JS add, zero new cart JS. Every other decision renders an
   options link to the detail page: a grid add can never be honest about unchosen variants,
   required add-ons, or zero buyable variants.

   The wishlist heart ships `hidden` (spec §5): it becomes visible ONLY after the wishlist
   store initializes; no-JS or unavailable localStorage keeps it absent — never an inert
   control. Cache-safe by construction: no session data and no CSRF token in this markup —
   the Origin/Referer check is the request-level defense, exactly like the product page's
   own server-rendered form. #}
<li class="shop-grid__item">
  <div class="shop-grid__tile">
    <span class="shop-grid__media">
      {% if product.coverUrl %}
        <img class="shop-grid__image" src="{{ product.coverUrl }}" alt="{{ product.name }}"
             loading="lazy" decoding="async">
      {% else %}
        <span class="shop-grid__image shop-grid__image--empty" aria-hidden="true"></span>
      {% endif %}
    </span>
    {% if product.categoryName %}
      <span class="shop-grid__tag">{{ product.categoryName }}</span>
    {% endif %}
    <div class="shop-grid__actions">
      {% if product.cartMode == 'direct' %}
        <form class="shop-grid__cart-form" method="post" action="/_shop/cart/add">
          <input type="hidden" name="variant_uuid" value="{{ product.directVariantUuid }}">
          <input type="hidden" name="quantity" value="1">
          <button class="shop-grid__action shop-grid__action--cart" type="submit"
                  aria-label="Add {{ product.name }} to cart">
            {# The SAME shopping-bag glyph the header mini-cart uses. #}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10.2257 4.11475C9.00726 4.11475 8.01953 5.10247 8.01953 6.3209V8.94835C8.01953 9.36257 7.68374 9.69835 7.26953 9.69835C6.85532 9.69835 6.51953 9.36257 6.51953 8.94835V6.3209C6.51953 4.27405 8.17883 2.61475 10.2257 2.61475C12.2725 2.61475 13.9318 4.27405 13.9318 6.3209V8.94835C13.9318 9.36257 13.596 9.69835 13.1818 9.69835C12.7676 9.69835 12.4318 9.36257 12.4318 8.94835V6.3209C12.4318 5.10247 11.4441 4.11475 10.2257 4.11475Z" fill="currentColor"></path>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M13.6212 4.11475C13.1495 4.11475 12.7144 4.26196 12.3564 4.51298C12.0173 4.75082 11.5496 4.6687 11.3117 4.32958C11.0739 3.99045 11.156 3.52273 11.4951 3.28489C12.0972 2.86266 12.8314 2.61475 13.6212 2.61475C15.668 2.61475 17.3274 4.27405 17.3274 6.3209V7.01644C17.3274 7.43066 16.9916 7.76644 16.5774 7.76644C16.1631 7.76644 15.8274 7.43066 15.8274 7.01644V6.3209C15.8274 5.10247 14.8396 4.11475 13.6212 4.11475Z" fill="currentColor"></path>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M3.67976 8.3691C3.76792 7.19513 4.74616 6.2876 5.92344 6.2876H17.7034C18.8536 6.2876 19.8187 7.15517 19.9407 8.29894L21.2023 20.126C21.2075 20.1746 21.2132 20.2258 21.2191 20.2787C21.2439 20.499 21.272 20.7497 21.2778 20.9729C21.2847 21.2395 21.2689 21.6206 21.0739 21.9595C20.919 22.2285 20.6721 22.4185 20.3699 22.4875C20.0958 22.5501 19.8438 22.4984 19.6608 22.4328C19.3315 22.3146 19.0382 22.0855 18.8321 21.8534C18.3272 22.3356 17.6496 22.6147 16.9326 22.6147H5.03524C3.72621 22.6147 2.69353 21.5016 2.79156 20.1962L3.67976 8.3691ZM5.92344 7.7876C5.53101 7.7876 5.20493 8.09011 5.17554 8.48143L4.28734 20.3085C4.25467 20.7437 4.5989 21.1147 5.03524 21.1147H16.9326C17.3744 21.1147 17.7834 20.8815 18.0084 20.5013L18.1555 20.2527C18.2801 20.042 18.4998 19.9054 18.7439 19.8868C18.988 19.8682 19.2259 19.9699 19.3811 20.1593L19.7459 20.6044C19.7416 20.5653 19.7371 20.5246 19.7323 20.482C19.7255 20.4205 19.7182 20.3552 19.7108 20.2852L18.4491 8.45804C18.4085 8.07679 18.0868 7.7876 17.7034 7.7876H5.92344ZM20.1714 21.0222C20.1715 21.0222 20.1705 21.022 20.1685 21.0213C20.1704 21.0218 20.1713 21.0221 20.1714 21.0222Z" fill="currentColor"></path>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M11.6035 7.0376C11.6035 6.62338 11.9393 6.2876 12.3535 6.2876H14.4819C15.6592 6.2876 16.6374 7.19513 16.7256 8.3691L17.6138 20.1962C17.7118 21.5016 16.6792 22.6147 15.3701 22.6147H12.3535C11.9393 22.6147 11.6035 22.2789 11.6035 21.8647C11.6035 21.4505 11.9393 21.1147 12.3535 21.1147H15.3701C15.8065 21.1147 16.1507 20.7437 16.118 20.3085L15.2298 8.48143C15.2004 8.09011 14.8744 7.7876 14.4819 7.7876H12.3535C11.9393 7.7876 11.6035 7.45181 11.6035 7.0376Z" fill="currentColor"></path>
              <path fill-rule="evenodd" clip-rule="evenodd" d="M7.08398 16.9912C7.08398 16.577 7.41977 16.2412 7.83398 16.2412H11.9434C12.3576 16.2412 12.6934 16.577 12.6934 16.9912C12.6934 17.4054 12.3576 17.7412 11.9434 17.7412H7.83398C7.41977 17.7412 7.08398 17.4054 7.08398 16.9912Z" fill="currentColor"></path>
            </svg>
          </button>
        </form>
      {% else %}
        <a class="shop-grid__action shop-grid__action--options" href="{{ product.url }}"
           aria-label="View options for {{ product.name }}">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
          </svg>
        </a>
      {% endif %}
      <button class="shop-grid__action shop-grid__action--wishlist" type="button"
              hidden data-shop-wishlist-toggle data-product-uuid="{{ product.uuid }}" aria-pressed="false"
              aria-label="Save {{ product.name }} to wishlist">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </button>
    </div>
  </div>
  <span class="shop-grid__body">
    <a class="shop-grid__name" href="{{ product.url }}">{{ product.name }}</a>
    {# Meta row (approved artifact): rating left, price right on ONE line. #}
    <span class="shop-grid__meta">
      {# The rating slot ALWAYS renders so every card's meta row aligns (operator decision
         2026-07-28). No reviews yet → a muted star with 0 (0); `rating` itself stays null
         in the projection, so the DATA never claims a zero-star rating. #}
      {% set rating_average = product.rating ? product.rating.average : 0 %}
      {% set rating_count = product.rating ? product.rating.count : 0 %}
      <span class="shop-grid__rating{% if not product.rating %} shop-grid__rating--none{% endif %}">
        <svg class="shop-grid__star" viewBox="0 0 24 24" fill="currentColor"
             aria-hidden="true" focusable="false">
          <path d="M12 2l2.9 6.26 6.85.63-5.17 4.6 1.53 6.72L12 16.7l-6.11 3.51 1.53-6.72-5.17-4.6 6.85-.63z"/>
        </svg>
        {% if product.rating %}<span class="sr-only">Rated </span>{% else %}<span class="sr-only">No reviews yet. </span>{% endif %}{{ rating_average|number_format(1) }}
        <span class="shop-grid__rating-count">({{ rating_count }})</span>
      </span>
      {% if product.priceFormatted %}
        <span class="shop-grid__price">
          <span class="shop-grid__price-current">{{ product.priceFormatted }}</span>
          {% if product.compareAtFormatted %}<s>{{ product.compareAtFormatted }}</s>{% endif %}
        </span>
      {% endif %}
    </span>
  </span>
</li>
