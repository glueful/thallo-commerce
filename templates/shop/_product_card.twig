{# _product_card.twig — one shop grid card (context: `product`, a ProductViewModel
   projection). Shared by shop/index.twig and shop/category.twig so the card anatomy
   never drifts between them: soft image panel → name (THE link to the detail page),
   rating (only when reviews exist), price row. The star SVG is commerce-owned inline
   and currentColor, matching the mini-cart icon convention. #}
<li class="shop-grid__item">
  <span class="shop-grid__media">
    {% if product.coverUrl %}
      <img class="shop-grid__image" src="{{ product.coverUrl }}" alt="{{ product.name }}"
           loading="lazy" decoding="async">
    {% else %}
      <span class="shop-grid__image shop-grid__image--empty" aria-hidden="true"></span>
    {% endif %}
  </span>
  <span class="shop-grid__body">
    <a class="shop-grid__name" href="{{ product.url }}">{{ product.name }}</a>
    {% if product.rating %}
      <span class="shop-grid__rating">
        <svg class="shop-grid__star" viewBox="0 0 24 24" fill="currentColor"
             aria-hidden="true" focusable="false">
          <path d="M12 2l2.9 6.26 6.85.63-5.17 4.6 1.53 6.72L12 16.7l-6.11 3.51 1.53-6.72-5.17-4.6 6.85-.63z"/>
        </svg>
        <span class="sr-only">Rated </span>{{ product.rating.average|number_format(1) }}
        <span class="shop-grid__rating-count">({{ product.rating.count }})</span>
      </span>
    {% endif %}
    {% if product.priceFormatted %}
      <span class="shop-grid__price">
        <span class="shop-grid__price-current">{{ product.priceFormatted }}</span>
        {% if product.compareAtFormatted %}<s>{{ product.compareAtFormatted }}</s>{% endif %}
      </span>
    {% endif %}
  </span>
</li>
