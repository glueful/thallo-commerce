{% extends 'layout.twig' %}
{% block title %}Shop — {{ site.name }}{% endblock %}
{% block content %}
  <link rel="canonical" href="{{ canonical }}">
  {# Baseline shop styling (same fingerprinted asset the product page loads). #}
  <link rel="stylesheet" href="/_shop/assets/shop.css">
  {# data-shop-scope (storefront-v1 spec §5): the opaque wishlist storage scope shop.js's
     wishlist store reads — the attribute is OMITTED entirely (never empty) when the seam
     answers null (commerce off / seam unbound), so wishlist enhancement simply stays off. #}
  {% set wishlist_scope = shop_wishlist_scope() %}
  <section class="shop-index"{% if wishlist_scope %} data-shop-scope="{{ wishlist_scope }}"{% endif %}>
    <h1>Shop</h1>
    {# Category chip rail (spec §2): "All" (active here) + one chip per category; zero
       categories → no rail at all. Every href comes from ShopUrlGenerator via the
       controller's closed {name, url, active} projection. #}
    {% if categories %}
      <nav class="shop-rail" aria-label="Categories">
        <a class="shop-rail__chip shop-rail__chip--active" aria-current="page" href="{{ shop_index }}">All</a>
        {% for chip in categories %}
          <a class="shop-rail__chip" href="{{ chip.url }}">{{ chip.name }}</a>
        {% endfor %}
      </nav>
    {% endif %}
    <ul class="shop-grid">
      {% for product in grid.items %}
        {% include 'shop/_product_card.twig' %}
      {% else %}
        <li class="empty">No products yet.</li>
      {% endfor %}
    </ul>
    {% set pagination = {
      page: grid.page,
      total_pages: grid.totalPages,
      prev_path: grid.prevPath,
      next_path: grid.nextPath,
    } %}
    {% include '_pagination.twig' %}
  </section>
{% endblock %}
