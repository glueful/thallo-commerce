{% extends 'layout.twig' %}
{% block title %}Shop — {{ site.name }}{% endblock %}
{% block content %}
  <link rel="canonical" href="{{ canonical }}">
  {# Baseline shop styling (same fingerprinted asset the product page loads). #}
  <link rel="stylesheet" href="/_shop/assets/shop.css">
  <section class="shop-index">
    <h1>Shop</h1>
    <ul class="shop-grid">
      {% for product in grid.items %}
        {% include 'shop/_product_card.twig' %}
      {% else %}
        <li class="empty">No products yet.</li>
      {% endfor %}
    </ul>
    {% set pagination = {
      page: grid.page,
      total_pages: grid.totalPages,
      prev_path: grid.prevPath,
      next_path: grid.nextPath,
    } %}
    {% include '_pagination.twig' %}
  </section>
{% endblock %}
