{% extends 'layout.twig' %}
{% block title %}Shop — {{ site.name }}{% endblock %}
{% block content %}
  <link rel="canonical" href="{{ canonical }}">
  {# Baseline shop styling (same fingerprinted asset the product page loads). #}
  <link rel="stylesheet" href="/_shop/assets/shop.css">
  <section class="shop-index">
    <h1>Shop</h1>
    <ul class="shop-grid">
      {% for product in grid.items %}
        <li class="shop-grid__item">
          <a href="{{ product.url }}">
            {% if product.coverUrl %}
              <img class="shop-grid__image" src="{{ product.coverUrl }}" alt="{{ product.name }}" loading="lazy">
            {% else %}
              <span class="shop-grid__image shop-grid__image--empty" aria-hidden="true"></span>
            {% endif %}
            <span class="shop-grid__name">{{ product.name }}</span>
            {% if product.priceFormatted %}
              <span class="shop-grid__price">
                {{ product.priceFormatted }}
                {% if product.compareAtFormatted %}<s>{{ product.compareAtFormatted }}</s>{% endif %}
              </span>
            {% endif %}
          </a>
        </li>
      {% else %}
        <li class="empty">No products yet.</li>
      {% endfor %}
    </ul>
    {% set pagination = {
      page: grid.page,
      total_pages: grid.totalPages,
      prev_path: grid.prevPath,
      next_path: grid.nextPath,
    } %}
    {% include '_pagination.twig' %}
  </section>
{% endblock %}
