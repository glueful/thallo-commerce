{# product-grid — storefront-rendering spec §5.2/§10: page 1 of a live catalog source
   (category | tag | manual list | newest), JS-hydrated. The block renders only a stable,
   cacheable shell carrying its configuration as data-* attributes — shop.js reads them, calls
   `GET /_shop/blocks/product-grid`, and paints the items plus a "view all" link that ALWAYS
   points at the canonical shop/category route the JSON supplied (never a query-paginated
   builder-page link — the grid itself only ever shows page 1). Every product/category URL
   comes from ShopUrlGenerator at JSON-build time in ShopBlockDataController — Twig never
   constructs one here. #}
{% set source = ({category: 'category', tag: 'tag', manual: 'manual', newest: 'newest'}[data.source|default('newest')] ?? 'newest') %}
{% set pageSize = ({small: 12, medium: 24, large: 48}[data.page_size|default('medium')] ?? 24) %}
<div class="thallo-block thallo-block-product-grid" data-shop-block="product-grid"
     data-source="{{ source }}"
     data-category-slug="{{ data.category_slug|default('') }}"
     data-tag-slug="{{ data.tag_slug|default('') }}"
     data-products="{{ data.products|default('') }}"
     data-page-size="{{ pageSize }}">
  <ul class="thallo-block-product-grid__items" data-shop-grid-items hidden></ul>
  <p class="thallo-block-product-grid__empty" data-shop-grid-empty>Loading products…</p>
  <a class="thallo-block-product-grid__view-all" data-shop-grid-view-all hidden href="#">View all products</a>
  {# Commerce-Slice-2 Fix A: a grid has no single "the" product to link to, so its no-JS
     fallback links to the same catalog entry point its own "view all" link would resolve to —
     the configured category when the source is category-scoped, otherwise the shop index.
     Same soft-bound/null-safe/cache-safe reasoning as add-to-cart.twig/featured-product.twig. #}
  {% set noscript_url = (source == 'category' and data.category_slug)
    ? shop_category_url(data.category_slug)
    : shop_index_url() %}
  <noscript>
    {% if noscript_url %}
      <p class="thallo-block-product-grid__noscript"><a href="{{ noscript_url }}">Browse products</a></p>
    {% else %}
      <p class="thallo-block-product-grid__noscript">Enable JavaScript to browse this product grid.</p>
    {% endif %}
  </noscript>
</div>
{# The stable, deploy-invariant asset alias (see ShopAssetController) — no Twig function can
   call ShopUrlGenerator::assets() directly, so every shop block loads shop.js this way. #}
<script src="/_shop/assets/shop.js" defer></script>

