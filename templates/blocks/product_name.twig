{# product_name — the product's name (type layouts plan C1); its level and whether it links to the
   product are its settings. Inside a Product list card (plan C2: `item` is set only there) it is the
   grid card's name — `shop-grid__name`, one line, ellipsized — and elsewhere the product page's. #}
{% set product = layout_context.product|default(null) %}
{% set level = ({h1: 'h1', h2: 'h2', h3: 'h3', h4: 'h4'}[data.level|default('h1')] ?? 'h1') %}
{% set part = item|default(null) is not null ? 'shop-grid__name' : 'shop-product__name' %}
{% if product %}
<{{ level }} class="thallo-block thallo-block-product_name {{ part }}{{ style_classes('root') }}"{{ style_attrs('root') }}>{% if data.link|default(false) %}<a href="{{ product.url }}">{{ product.name }}</a>{% else %}{{ product.name }}{% endif %}</{{ level }}>
{% endif %}
