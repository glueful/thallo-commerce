{# add-to-cart — storefront-rendering spec §5.2/§10: "simple products submit directly;
   variant/add-on products render required controls or link to detail — never an invalid cart
   line." `product_slug` is optional and falls back to the current entry's linked commerce
   product (same enrichment-context rule as featured-product.twig). The form stays hidden until
   shop.js resolves `GET /_shop/blocks/add-to-cart` and decides the mode:
     - direct  → a single hidden variant_uuid is filled in and the form is revealed
     - select  → a real <select> of active variants is built into the variant slot and revealed
     - link    → the form stays hidden; a "View product" link is revealed instead
     - unavailable → neither is revealed; only the status message is shown
   This shell never submits a form on its own — nothing here can become an invalid cart line. #}
{# data-shop-scope (storefront-v1 spec §5): the opaque wishlist storage scope — OMITTED
   entirely (never empty) when the seam answers null, exactly like every other shop root. #}
{% set slug = data.product_slug|default('') %}
{% set entry_uuid = entry.uuid|default('') %}
{% if is_canvas() %}
{# The stage (sections and templates design §6): shop behaviour never runs there, so the block is a
   named placeholder — the product it adds, or "choose a product" — that keeps the block's authored
   styling (width, spacing, placement, style classes) and stays selectable. #}
{% set label = shop_block_product_label(slug, entry_uuid) %}
<div class="thallo-block thallo-block-add-to-cart thallo-field-empty{{ style_classes('root') }}"{{ style_attrs('root') }}>Add to cart — {{ label ?: 'choose a product' }}</div>
{% elseif slug != '' or entry_uuid != '' %}
{# The site: no product can be found with neither a slug nor an entry (a block outside an entry), so
   nothing renders then. Otherwise the shell — shop.js hides it when nothing is configured, and says
   "This product is not available." for a chosen product that is gone. #}
{% set wishlist_scope = shop_wishlist_scope() %}
<div class="thallo-block thallo-block-add-to-cart{{ style_classes('root') }}"{{ style_attrs('root') }} data-shop-block="add-to-cart"
     {%- if wishlist_scope %} data-shop-scope="{{ wishlist_scope }}"{% endif %}
     data-product-slug="{{ data.product_slug|default('') }}"
     data-entry-uuid="{{ entry.uuid|default('') }}">
  {# Hidden until shop.js starts hydrating: without JavaScript the reader sees only the noscript
     line below, never a "Loading…" that nothing will finish. #}
  <p class="thallo-block-add-to-cart__status" data-shop-add-to-cart-status hidden>Loading…</p>

  <form class="thallo-block-add-to-cart__form" method="post" action="/_shop/cart/add"
        data-shop-add-to-cart-form hidden>
    <div class="thallo-block-add-to-cart__variant" data-shop-add-to-cart-variant-slot></div>
    <label class="thallo-block-add-to-cart__qty">
      <span class="sr-only">Quantity</span>
      <input type="number" name="quantity" min="1" step="1" value="1" inputmode="numeric">
    </label>
    <button type="submit">Add to cart</button>
  </form>

  <a class="thallo-block-add-to-cart__link" data-shop-add-to-cart-link hidden href="#">View product</a>

  {# Without JavaScript: a link to the shop, a page that always exists — a WORKING path to the cart,
     never an inert shell. A product URL would be built without checking the product
     (shop_product_url() looks nothing up), so a slug whose product is gone would give a dead link.
     A blank block may have no product at all (an unlinked page), so its line promises none. #}
  <noscript>
    <p class="thallo-block-add-to-cart__noscript">
      <a href="{{ shop_index_url() }}">{{ slug != '' ? 'Browse the shop to add this product to your cart' : 'Browse the shop' }}</a>
    </p>
  </noscript>
</div>
{# The storefront stylesheet rides inside the theme artifact (visual builder spec §2.2);
   only the behaviour script is loaded here — duplicate script tags dedupe at fetch time. #}
<script src="/_thallo/shop/shop.js" defer></script>
{% endif %}
