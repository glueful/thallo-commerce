{# product_buy — Product buy box (type layouts plan C1): the product page's buy area with its fixed
   internals — the server-built, no-JS form (or native select, or the honest "not available"
   line), the stepper, the wishlist heart and the availability line — shared with shop/product.twig
   through shop/_product_buy.twig. Every product layout holds exactly one. #}
{% set product = layout_context.product|default(null) %}
{% if product %}
<div class="thallo-block thallo-block-product_buy{{ style_classes('root') }}"{{ style_attrs('root') }}>
{% include 'shop/_product_buy.twig' with {
  product: product,
  show_wishlist: not (data.hide_wishlist|default(false)),
  show_availability: not (data.hide_availability|default(false)),
} %}
</div>
{% endif %}
