{# mini-cart — storefront-rendering spec §5.2/§9/§10: "a stable, cacheable shell; contents
   hydrate via GET /_shop/cart (JSON, no-store); a plain /cart link without JS." The count/lines/
   total below are ALWAYS rendered empty/zero server-side (so this block never bypasses the page
   cache with visitor-specific data) — shop.js fetches the real cart on every page load and
   repaints them, and again after every cart mutation elsewhere on the page. #}
<div class="thallo-block thallo-block-mini-cart" data-shop-mini-cart>
  {# Icon button with a corner count badge (the standard storefront pattern). The SVG is
     commerce-owned inline (Lucide shopping-cart, currentColor) — no cross-pack icon
     dependency — and aria-hidden; the sr-only span keeps the accessible name. #}
  <button type="button" class="thallo-block-mini-cart__toggle" data-shop-cart-toggle
          aria-expanded="false" aria-controls="thallo-mini-cart-panel">
    <svg class="thallo-block-mini-cart__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="8" cy="21" r="1"/>
      <circle cx="19" cy="21" r="1"/>
      <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
    </svg>
    <span class="sr-only">Cart</span>
    {# Ships hidden: the cacheable shell is always zero, and a zero badge is noise —
       shop.js's cart paint reveals it only when the cart has items. #}
    <span class="thallo-block-mini-cart__count" data-shop-cart-count hidden>0</span>
  </button>

  <div id="thallo-mini-cart-panel" class="thallo-block-mini-cart__panel" data-shop-cart-drawer>
    <p class="thallo-block-mini-cart__empty" data-shop-cart-empty>Your cart is empty.</p>
    <ul class="thallo-block-mini-cart__lines" data-shop-cart-lines hidden></ul>
    <p class="thallo-block-mini-cart__total" data-shop-cart-total hidden></p>
    <a class="thallo-block-mini-cart__link" data-shop-cart-link href="/cart">View cart</a>
  </div>

  <noscript>
    <p class="thallo-block-mini-cart__noscript"><a href="/cart">View cart</a></p>
  </noscript>
</div>
{# Baseline shop styling (same fingerprinted asset the catalog pages load) — duplicate
   link tags across blocks on one page dedupe at fetch time, like the script tag below. #}
<link rel="stylesheet" href="/_shop/assets/shop.css">
<script src="/_shop/assets/shop.js" defer></script>

