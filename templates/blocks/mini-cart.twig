    </svg>
    <span class="sr-only">Cart</span>
    {# Ships hidden: the cacheable shell is always zero, and a zero badge is noise —
       shop.js's cart paint reveals it only when the cart has items. #}
    <span class="thallo-block-mini-cart__count" data-shop-cart-count hidden>0</span>
  </button>

  {# `hidden` covers the PRE-CSS moment (and no-CSS UAs): the drawer must never flash
     expanded before the stylesheet loads. Once CSS applies, the author display rules
     (default none; aria-expanded="true" → block) override the UA [hidden] style, so
     the attribute stays inert afterwards — shop.js only flips aria-expanded. #}
  <div id="thallo-mini-cart-panel" class="thallo-block-mini-cart__panel" data-shop-cart-drawer hidden>
    <p class="thallo-block-mini-cart__empty" data-shop-cart-empty>Your cart is empty.</p>
    <ul class="thallo-block-mini-cart__lines" data-shop-cart-lines hidden></ul>
    <p class="thallo-block-mini-cart__total" data-shop-cart-total hidden></p>
    <a class="thallo-block-mini-cart__link" data-shop-cart-link href="/cart">View cart</a>
  </div>

  <noscript>
    <p class="thallo-block-mini-cart__noscript"><a href="/cart">View cart</a></p>
  </noscript>
</div>
{# Baseline shop styling (same fingerprinted asset the catalog pages load) — duplicate
   link tags across blocks on one page dedupe at fetch time, like the script tag below. #}
<link rel="stylesheet" href="/_shop/assets/shop.css">
<script src="/_shop/assets/shop.js" defer></script>

